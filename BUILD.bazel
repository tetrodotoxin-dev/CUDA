load("//build:release.bzl", "sdk_release")

sdk_release(
    name = "release",
    headers = [
        "//source/cuda/contracts:public_headers",
        "//source/cuda/runtime:public_headers",
    ],
    library = "//source/cuda:plugin",
    scripts = [".vscode/format.sh"],
    sources = glob([
        ".bazelrc",
        ".bazelversion",
        ".clang-format",
        ".gitignore",
        "*.md",
        "BUILD.bazel",
        "LICENSE",
        "MODULE.bazel",
    ]) + [
        "//build:sources",
        "//source/cuda:sources",
        "//source/cuda/contracts:sources",
        "//source/cuda/runtime:sources",
        "//validation:sources",
    ],
)
